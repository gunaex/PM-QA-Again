# Copy to .env and adjust for your deploy target.
# Local dev works fine with NO .env file at all — these are only read if
# actually set; unset, the app falls back to the same local defaults it
# always used (backend/data, http://localhost:5173).

# Parent data directory. Holds master.db (the project registry) and the
# projects/ subfolder (one SQLite file per project, plus each project's
# evidence/ subfolder). On Fly.io this should match the persistent
# volume's mount path (see fly.toml).
DATA_DIR=/app/data

# Comma-separated list of origins allowed to call this API (CORS).
# Include your deployed frontend's origin(s), e.g.:
# ALLOWED_ORIGINS=https://qaagain.kanphong.com,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Local launcher only: allow Vite's fallback port (5174, 5175, ...) and
# either localhost or 127.0.0.1. Never enable this on a deployed backend.
ALLOW_LOCAL_DEV_ORIGINS=false

# --- Auth / security ---
# JWT signing secret. REQUIRED before deploying — without it the app
# generates a random one per process start, meaning every restart logs
# everyone out. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Set via `fly secrets set JWT_SECRET_KEY=...` — never commit the real value.
# QA-Again's own secret — never shared with PM-Again's.
JWT_SECRET_KEY=

# Bootstrap admin account, created once on first startup if the users table
# is empty. If ADMIN_PASSWORD is left unset, a random one is generated and
# logged once (fine for local dev; set both explicitly for a real deploy).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Cookie security flags for the auth tokens. Must be "true" in production
# (HTTPS-only, SameSite=None so the cookie is sent cross-site from the
# Cloudflare Pages frontend to the Fly backend). Leave "false" for local
# dev, where frontend and backend are same-origin via the Vite proxy over
# plain HTTP.
COOKIE_SECURE=false

# --- Evidence storage (ADR-0002) ---
# "filesystem" (default) stores evidence under DATA_DIR/evidence — zero
# config, used for local dev. "r2" stores evidence in a private
# Cloudflare R2 bucket via its S3-compatible API — required in
# production. See docs/DEPLOYMENT.md for bucket setup and
# docs/ADR-0002-evidence-storage-r2.md for the full decision.
STORAGE_BACKEND=filesystem

# Only required when STORAGE_BACKEND=r2. Never commit real values — set
# via `fly secrets set` in production.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Browser test execution ---
# Local development may leave this as "local" and run runner/ manually.
# Production uses short-lived GitHub-hosted Playwright jobs; no always-on
# runner server is required. Store real values as deployment secrets.
# embedded = local one-shot browser, no runner terminal; github_actions = production
EXECUTION_PROVIDER=embedded
EMBEDDED_BACKEND_BASE_URL=http://127.0.0.1:8000
EMBEDDED_RUNNER_HEADLESS=0
GITHUB_ACTIONS_TOKEN=
GITHUB_ACTIONS_REPOSITORY=gunaex/PM-QA-Again
GITHUB_ACTIONS_WORKFLOW=run-browser-test.yml
GITHUB_ACTIONS_REF=main
